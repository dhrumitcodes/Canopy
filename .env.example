# Copy this file to .env for local Docker Compose use.
# Replace every placeholder before exposing the application publicly.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Generate with: openssl rand -base64 48 (at least 32 decoded bytes).
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_EXPIRATION_MS=28800000
# Comma-separated official college domains; leave empty to disable domain allow-listing.
ALLOWED_EMAIL_DOMAINS=
# Browser origin(s), comma-separated, without trailing slash.
WEB_ORIGIN=http://localhost:3000
# Public API URL embedded into the frontend build.
API_PUBLIC_URL=http://localhost:8080/api/v1
